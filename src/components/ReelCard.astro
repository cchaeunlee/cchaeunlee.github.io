---
// 9:16 릴스 카드. 썸네일이 없으면 브랜드명을 타이포그래피로 보여줍니다.
import { workTitle, formatDate, type Work } from '../lib/works';
import type { Lang } from '../i18n/ui';

interface Props {
  work: Work;
  lang: Lang;
  size?: 'sm' | 'md';
}
const { work, lang, size = 'md' } = Astro.props;
const title = workTitle(work, lang);
---

<div class:list={['reel', `reel--${size}`]}>
  {
    work.thumbnail ? (
      <img src={work.thumbnail} alt={title} loading="lazy" decoding="async" />
    ) : (
      <div class="reel__placeholder" aria-hidden="true">
        <span>{title}</span>
      </div>
    )
  }
  {
    work.preview && (
      <video class="reel__preview" src={work.preview} muted loop playsinline preload="none" />
    )
  }
  <div class="reel__meta">
    <span class="reel__badge">{work.format === 'image' ? 'IMAGE' : 'REELS'}</span>
    {size === 'md' && <span class="reel__date">{formatDate(work.date, lang)}</span>}
  </div>
</div>

<style>
  .reel {
    position: relative;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    background: var(--black);
    color: var(--white);
  }
  .reel img,
  .reel__preview {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .reel__preview {
    opacity: 0;
    transition: opacity 0.3s;
  }
  .reel__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 14%;
    text-align: center;
    border: 1px solid rgba(250, 250, 248, 0.18);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.06), transparent 40%),
      var(--black);
  }
  .reel__placeholder span {
    font-family: var(--serif);
    font-size: 1.35em;
    line-height: 1.2;
  }
  .reel--sm .reel__placeholder span {
    font-size: 1em;
  }
  .reel__meta {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 10px;
    letter-spacing: 0.14em;
  }
  .reel__badge {
    padding: 3px 7px;
    border: 1px solid rgba(250, 250, 248, 0.6);
  }
  .reel__date {
    opacity: 0.7;
  }
</style>
