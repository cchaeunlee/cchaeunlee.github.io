---
import { site } from '../config/site';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).piano;
---

<section class="section piano section--dark" id="piano">
  <div class="container">
    <p class="eyebrow">Performance</p>
    <h2 class="section-title reveal">{s.title}</h2>
    <div class="piano__frame reveal">
      {
        site.pianoYoutubeId ? (
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${site.pianoYoutubeId}`}
            title={s.title}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          />
        ) : (
          <>
            <img src="/video/hero-poster.jpg" alt="" loading="lazy" />
            <p class="piano__soon">{s.comingSoon}</p>
          </>
        )
      }
    </div>
  </div>
</section>

<style>
  .piano__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--ink);
  }
  .piano__frame iframe,
  .piano__frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }
  .piano__frame img {
    filter: grayscale(1) brightness(0.55);
  }
  .piano__soon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(18px, 2.4vw, 28px);
    text-align: center;
    padding: 0 16px;
  }
</style>
